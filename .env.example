APP_NAME=СкладAI
APP_ENV=local
SECRET_KEY=replace-this-secret-before-server-deploy
ACCESS_TOKEN_MINUTES=720
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_FULL_NAME=Администратор

# PostgreSQL mode. For instant local demo, comment this line and the backend will use SQLite in backend/data/dev.db.
DATABASE_URL=postgresql+psycopg2://skladai:skladai@localhost:5432/skladai

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI assistant — local model via Ollama (optional).
# The chat answers from local warehouse rules instantly; open/analytical
# questions go to a local model through Ollama. Leave OLLAMA_HOST empty to run
# rules-only (the app works fully without a model).
# OLLAMA_HOST=http://127.0.0.1:11434
# AI_MODEL=qwen3:latest
# AI_NO_THINK=true          # qwen3: skip chain-of-thought (~2x faster, on-task)
# AI_TIMEOUT_SECONDS=120
# AI_NUM_PREDICT=600        # cap on answer length (tokens)
# AI_HISTORY_TURNS=6        # recent chat turns sent to the model for context
