APP_NAME=СкладAI
APP_ENV=local
SECRET_KEY=replace-this-secret-before-server-deploy
ACCESS_TOKEN_MINUTES=720
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_FULL_NAME=Администратор

# PostgreSQL mode. For instant local demo, comment this line and the backend will use SQLite in backend/data/dev.db.
DATABASE_URL=postgresql+psycopg2://skladai:skladai@localhost:5432/skladai

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional Claw Code AI-agent integration (your own model, no Claude).
# Build ../claw-code-main/rust first (cargo build --workspace), then enable this.
CLAW_AGENT_ENABLED=false
CLAW_BINARY_PATH=../claw-code-main/rust/target/debug/claw.exe
CLAW_WORKSPACE=.
# Prefix the model with its provider so Claw routes to the right backend,
# e.g. openai/<model> for an OpenAI-compatible server, or an Ollama model name.
CLAW_MODEL=
CLAW_PERMISSION_MODE=read-only
CLAW_TIMEOUT_SECONDS=45

# Point Claw at your own neural network. Pick ONE provider:
#  - OpenAI-compatible server (incl. Ollama's /v1, vLLM, LM Studio, your API):
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=local-or-your-provider-key
#  - or a native Ollama instance:
# OLLAMA_HOST=http://127.0.0.1:11434
