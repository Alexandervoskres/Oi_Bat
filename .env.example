APP_NAME=СкладAI
APP_ENV=local
SECRET_KEY=replace-this-secret-before-server-deploy
ACCESS_TOKEN_MINUTES=720
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_FULL_NAME=Администратор

# PostgreSQL mode. For instant local demo, comment this line and the backend will use SQLite in backend/data/dev.db.
DATABASE_URL=postgresql+psycopg2://skladai:skladai@localhost:5432/skladai

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Claude API placeholder.
# Keep false until you add a real key and confirm billing/limits.
CLAUDE_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
